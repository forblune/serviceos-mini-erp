{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forblune-serviceos",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./gh-pages-dist",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "serviceos.forblune.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
